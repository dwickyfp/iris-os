# Linux with Docker Engine and a configured runsc runtime is required.
SANDBOX_RUNTIME_IMAGE=iris-sandbox-runtime:local
# Runner must use the immutable digest produced after building the runtime image.
# Local: docker image inspect iris-sandbox-runtime:local --format '{{.Id}}'
# Production: registry/repository@sha256:<digest>
SANDBOX_RUNNER_IMAGE=sha256:
# Generate with: openssl rand -base64 48
SANDBOX_RUNNER_TOKEN=
SANDBOX_CONTROL_NETWORK=iris-sandbox-control
SANDBOX_EGRESS_NETWORK=iris-sandbox-egress

# Future runner configuration. Keep limits finite and enforce them again on
# every dynamically created child container.
SANDBOX_RUNNER_MAX_CONCURRENT_SESSIONS=4
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
