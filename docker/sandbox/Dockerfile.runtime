FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PIP_NO_CACHE_DIR=1

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 sandbox \
  && useradd --uid 10001 --gid sandbox --create-home sandbox

COPY docker/sandbox/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN pip install --require-hashes --requirement /tmp/requirements-runtime.txt \
  && rm /tmp/requirements-runtime.txt

WORKDIR /workspace
USER sandbox

CMD ["python", "-c", "import os,sys; print(f'sandbox-ready uid={os.getuid()} python={sys.version.split()[0]}')"]
