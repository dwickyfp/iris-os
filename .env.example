# Iris runtime bootstrap exceptions.
# All provider, OAuth, feature, timeout, MCP, Redis, and object-storage settings
# are configured in Admin > Settings and encrypted in PostgreSQL where needed.

# PostgreSQL is required before database-backed settings can be loaded.
POSTGRES_URL=postgres://iris:change-me@localhost:5432/iris

# Root key for Better Auth and encrypted application credentials.
# Generate once with: openssl rand -base64 32
# Keep stable across all web and worker replicas and include it in secure backups.
IRIS_ROOT_ENCRYPTION_KEY=

# Process/platform controls are not application settings.
NODE_ENV=development
PORT=3000
