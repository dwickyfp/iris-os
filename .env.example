# Iris runtime bootstrap exceptions.
# The only settings editable at runtime live in Admin > Settings (encrypted in
# PostgreSQL). Everything else is static application config with env overrides
# in `src/lib/app-config.ts` (feature flags, capability router, timeouts,
# default role, storage, and operations tuning).

# PostgreSQL is required before database-backed settings can be loaded.
POSTGRES_URL=postgres://iris:change-me@localhost:5432/iris

# Root key for Better Auth and encrypted application credentials.
# Generate once with: openssl rand -base64 32
# Keep stable across all web and worker replicas and include it in secure backups.
IRIS_ROOT_ENCRYPTION_KEY=

# Process/platform controls are not application settings.
NODE_ENV=development
PORT=3000

# Optional. When set, server caches are shared across web and worker
# processes via Redis (with automatic in-memory fallback). Without it every
# process uses its own MemoryCache.
# REDIS_URL=redis://localhost:6379

# Subagent spawning in chat (spawn_subagent tool). Enabled by default;
# set to "false" or "0" to disable.
# IRIS_SUBAGENTS_V2=false

# Workspace filesystem tool for agents (workspace_fs: scoped file read/write/
# edit/list/search, no code execution). Enabled by default; set to "false"
# or "0" to disable.
# IRIS_WORKSPACE_FS_V2=false

# Optional. Max duration in milliseconds for a single spawned subagent
# (30_000..300_000, default 120_000). The parent agent's step timeout is
# raised automatically to outlive it.
# AI_SUBAGENT_TIMEOUT_MS=120000
